    {
      "name": "search_papers",
      "title": "Search biomedical literature",
      "description": "Ranked PubMed literature search: Arca's paper index fused with PubMed Best Match, with citation and open-access metadata from OpenAlex. Returns papers with title, authors, journal, year, DOI, PMID, abstract, citation count, and open-access status.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 400,
            "description": "Natural-language research question or topic to find papers on."
          },
          "numResults": {
            "description": "Papers to return (1-25, default 10).",
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "minYear": {
            "description": "Only papers published in or after this year.",
            "type": "integer",
            "minimum": 1800,
            "maximum": 2100
          },
          "maxYear": {
            "description": "Only papers published in or before this year.",
            "type": "integer",
            "minimum": 1800,
            "maximum": 2100
          },
          "publicationTypes": {
            "description": "Only these PubMed publication types (e.g. Randomized Controlled Trial, Meta-Analysis, Systematic Review).",
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Randomized Controlled Trial",
                "Clinical Trial",
                "Meta-Analysis",
                "Systematic Review",
                "Review",
                "Observational Study",
                "Comparative Study",
                "Multicenter Study",
                "Case Reports",
                "Practice Guideline"
              ]
            }
          },
