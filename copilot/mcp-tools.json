    {
      "name": "fetch_source_record",
      "title": "Fetch one mirrored record",
      "description": "Read the indexed text of one public-source record by its recordId (returned by search_medical). Use after search when the excerpt is not enough. Returns a bounded text window; pass nextInput unchanged to continue. contentCapped reports text unavailable beyond the stored content.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "recordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "recordId from a search_medical result."
          },
          "startIndex": {
            "description": "Character offset from the previous result's nextInput; omit or null to start reading.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              {
                "type": "null"
              }
            ]
          },
          "contentHash": {
            "description": "The contentHash from nextInput, to refuse a page from a changed record. Omit or null to begin a new read.",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "recordId"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "recordId": {
            "type": "string"
          },
          "sourceKey": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          },
          "startIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "totalLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "contentCapped": {
            "type": "boolean"
          },
          "contentHash": {
            "type": "string"
          },
          "nextInput": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "recordId": {
                    "type": "string"
                  },
                  "startIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "contentHash": {
                    "type": "string"
                  }
                },
                "required": [
                  "recordId",
                  "startIndex",
                  "contentHash"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "recordId",
          "sourceKey",
          "title",
          "url",
          "text",
          "truncated",
          "startIndex",
          "endIndex",
          "totalLength",
          "contentCapped",
          "contentHash",
          "nextInput"
        ],
        "additionalProperties": false
      }
    },
