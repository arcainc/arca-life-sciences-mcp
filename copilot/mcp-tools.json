{
  "tools": [
    {
      "name": "search_medical",
      "title": "Search FDA, regulatory, and public health records",
      "description": "Hybrid keyword + semantic search over Arca's mirrored public-source corpus: FDA drug labels, Drugs@FDA approvals, complete response letters, warning letters, Orange Book, Purple Book, NDC, drug shortages, device 510(k)/PMA/registrations, MAUDE adverse events, food/supplement/cosmetic and animal drug adverse events, tobacco product problem reports, DailyMed, GUDID, postmarket requirements, import refusals, inspections, Form 483s, ClinicalTrials.gov studies, VAERS reports, CDC data, EU expert panel opinions, and BfArM/PMDA device vigilance. Press releases and SEC company filings are searched only when sourceTypes names press_releases or company_filings. Read-only lookup of already-published records: it cannot file, submit, or report anything to FDA, VAERS, MedWatch, or any other agency, so do not call it for requests to file or submit a report. When the question names a record type (warning letters, labels, adverse event reports, trials, recalls), pass the matching sourceTypes rather than searching the whole corpus. Results carry recordId for fetch_source_record and a citable source URL.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 400,
            "description": "Medical, pharma, clinical, regulatory, device, or safety research query."
          },
          "publicSourceFilters": {
            "description": "Exact metadata filters for FDA enforcement, 510(k)/PMA device decisions, drug labels, FDA guidance, ClinicalTrials.gov studies, Health Canada drug records, EudraGMDP, BfArM/PMDA device notices, FDA complete response letters, EU MDR/IVDR expert-panel opinions and FDA food, supplement, cosmetic and animal drug adverse event and tobacco problem reports (filter by reactions, eventOutcomes). Device record date is the decision date, not receipt. Label record date is SPL effective date. Trial record date is first submission, postedDate is first posting; study milestones and lastUpdateDate are separate. Unknown or partial dates do not match ranges.",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "trialStatuses": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "trialPhases": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "studyTypes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "feiNumbers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "applicationNumbers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "description": "Exact drug application, device K or PMA numbers, such as NDA209637, K070051 or P900052."
                  },
                  "productCodes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "recallNumbers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "recordTypes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "description": "483, EIR, RESPONSE, WARNING LETTER, INSPECTION, IMPORT REFUSAL, RECALL, ADVERSE EVENT, DRUG LABEL, 510(K) or PMA. Other upstream record types retain their names."
                  },
                  "recallClasses": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "description": "Recall classes I, II or III."
                  },
                  "inspectionOutcomes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "description": "FDA inspection classification codes NAI, VAI or OAI."
                  },
                  "productTypes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "description": "Upstream product type or category, including FDA import-refusal ProductCategory values such as Foods and CAERS industry names such as COSMETICS or VIT/MIN/PROT/UNCONV DIET(HUMAN/ANIMAL)."
                  },
                  "countries": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "states": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "recordIds": {
                    "description": "Exact upstream record identifiers, including SPL set/document IDs, trial NCT IDs, device K numbers, PMA supplements such as P900052-S016, PMIDs and substance UNIIs. A trial also lists the PMIDs of its result publications and its EudraCT, CTIS and other registry IDs; a GSRS substance also lists its CAS, DrugBank, ChEMBL and other codes, with numeric ones prefixed by their system, such as RXCUI:1191 or PUBCHEM:2244.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "ndcCodes": {
                    "description": "Exact NDC product codes, preserving leading zeroes and hyphens.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "decisionCodes": {
                    "description": "FDA device decision codes, such as SESE or APPR.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "deviceClasses": {
                    "description": "FDA device classes as upstream strings, such as 1, 2 or 3.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "dins": {
                    "description": "Exact Health Canada eight-digit Drug Identification Numbers, preserving leading zeroes.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "reactions": {
                    "description": "Exact reported reactions on FDA food, dietary supplement and cosmetic adverse event reports (MedDRA terms such as NAUSEA or ANAPHYLACTIC REACTION), FDA animal drug adverse event reports (VeDDRA terms such as VOMITING) and FDA tobacco product problem reports (health problems such as COUGHING).",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "eventOutcomes": {
                    "description": "Exact outcomes on FDA food, dietary supplement and cosmetic adverse event reports, such as DEATH, HOSPITALIZATION, LIFE THREATENING or VISITED EMERGENCY ROOM, and on FDA animal drug adverse event reports, such as DIED or EUTHANIZED.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "dateField": {
                    "description": "recordDate uses the source's record date: FDA device decision date, label SPL effective date or trial first submission. postedDate stays separate. Choose a trial milestone, lastUpdateDate or inspectionDate explicitly. Partial dates are excluded, never rounded to a day.",
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "recordDate",
                          "postedDate",
                          "studyStartDate",
                          "primaryCompletionDate",
                          "completionDate",
                          "lastUpdateDate",
                          "inspectionDate"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "startDate": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "endDate": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "description": "Exact metadata facets share a total budget of 50 values across all arrays. Split larger searches into separate requests."
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceTypes": {
            "description": "Optional source lanes to focus the search (see list_datasets). Omit to search the whole corpus.",
            "maxItems": 11,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "fda_records",
                "regulatory_guidance",
                "biomedical_literature",
                "clinical_trials",
                "public_health",
                "clinical_guidelines",
                "standards_quality",
                "global_regulatory",
                "device_vigilance",
                "press_releases",
                "company_filings"
              ]
            }
          },
          "numResults": {
            "description": "Results to return (1-25, default 10).",
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          }
        },
        "required": [
          "query"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
